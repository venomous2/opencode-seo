# DataForSEO (mandatory data backbone)
# Get credentials at https://app.dataforseo.com/register
DATAFORSEO_LOGIN=your_login_email
DATAFORSEO_PASSWORD=your_api_password

# --- Optional Google APIs (uncomment to enable tiers) ---
# Tier 0: PageSpeed Insights + CrUX field data
# GOOGLE_API_KEY=your_google_api_key
# Tier 1: + Search Console + Indexing (path to service account JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON=C:/path/to/service-account.json
# Tier 2: + GA4 organic traffic
# GA4_PROPERTY_ID=123456789
